"""Type stub for brotli 1.2.0, the one runtime dependency that ships no type information.

Signatures follow the C extension's docstrings and were checked by calling it.
"""

from collections.abc import Buffer
from typing import Final, final

__version__: Final[str]
version: Final[str]

MODE_GENERIC: Final[int]
MODE_TEXT: Final[int]
MODE_FONT: Final[int]

class error(Exception): ...

@final
class Compressor:
    def __init__(
        self, mode: int = ..., quality: int = ..., lgwin: int = ..., lgblock: int = ...
    ) -> None: ...
    def process(self, data: Buffer, /) -> bytes: ...
    def flush(self) -> bytes: ...
    def finish(self) -> bytes: ...

@final
class Decompressor:
    def __init__(self) -> None: ...
    # output_buffer_limit is a soft cap: the output can exceed it (plan §2).
    def process(self, data: Buffer, /, output_buffer_limit: int = ...) -> bytes: ...
    def is_finished(self) -> bool: ...
    def can_accept_more_data(self) -> bool: ...

def compress(
    string: Buffer, mode: int = ..., quality: int = ..., lgwin: int = ..., lgblock: int = ...
) -> bytes: ...
def decompress(string: Buffer) -> bytes: ...
